<?xml version="1.0" encoding="utf-8"?>
<ModMetaData>
  <name>Numbers Compatibility Patch</name>
  <author>Cruesoe</author>
  <packageId>cruesoe.autohuntnumberspatch</packageId>
  <modVersion IgnoreIfNoMatchingField="True">26082026</modVersion>
  <supportedVersions>
    <li>1.6</li>
  </supportedVersions>
  <description>Puts Auto Hunt's toggle and settings cog, and Auto Tame's settings button, on Numbers' wild animals table so Numbers' tab buttons no longer cover them.

Auto Hunt and Auto Tame are each optional — this patch enables whichever of them you have loaded.</description>
  <modDependencies>
    <li>
      <packageId>brrainz.harmony</packageId>
      <displayName>Harmony</displayName>
      <steamWorkshopUrl>steam://url/CommunityFilePage/2009463077</steamWorkshopUrl>
      <downloadUrl>https://github.com/pardeike/HarmonyRimWorld/releases/latest</downloadUrl>
    </li>
    <li>
      <packageId>Mehni.Numbers</packageId>
      <displayName>Numbers</displayName>
      <steamWorkshopUrl>https://steamcommunity.com/sharedfiles/filedetails/?id=1414302321</steamWorkshopUrl>
      <downloadUrl>https://github.com/Mehni/kNumbers</downloadUrl>
    </li>
  </modDependencies>
  <loadAfter>
    <li>brrainz.harmony</li>
    <li>Mehni.Numbers</li>
    <li>Snues.AutoHunt</li>
    <li>ceramic.autotame</li>
  </loadAfter>
</ModMetaData>
