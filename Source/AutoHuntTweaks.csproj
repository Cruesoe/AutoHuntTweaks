<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build settings, RimWorld references and the copy into 1.6\Assemblies all come
       from _ModKit via the Directory.Build.props/.targets at the repo root. -->
  <PropertyGroup>
    <RootNamespace>AutoHuntTweaks</RootNamespace>
    <AssemblyName>AutoHuntTweaks</AssemblyName>
    <Nullable>enable</Nullable>
    <UnityModules>CoreModule;IMGUIModule;TextRenderingModule</UnityModules>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>
</Project>

